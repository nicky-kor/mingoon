# Copy to .env and fill in what you have. Nothing here is required to run
# `research-os run` — the pipeline falls back to rule-based/heuristic
# processing when no LLM is configured (see docs/local-llm.md).

# console.anthropic.com/settings/keys 에서 발급받은 키를 넣으세요.
ANTHROPIC_API_KEY=your_api_key_here

# Optional cloud providers (Phase 2+)
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Local inference (Ollama). Defaults to http://localhost:11434 if unset.
OLLAMA_BASE_URL=http://localhost:11434
LLAMA_CPP_BASE_URL=http://localhost:8080
VLLM_BASE_URL=http://localhost:8000

# Optional: raises the GitHub search API rate limit for the GitHub collector.
GITHUB_TOKEN=
