# 구글(Gmail) - 2단계 인증을 켠 뒤 앱 비밀번호를 생성하세요.
# https://myaccount.google.com/apppasswords
GOOGLE_EMAIL=your_gmail_address@gmail.com
GOOGLE_APP_PASSWORD=your_app_password

# 네이버 - 메일 > 환경설정 > POP3/IMAP 설정에서 IMAP 사용을 켜고,
# 네이버 보안 설정에서 2단계 인증 및 애플리케이션 비밀번호를 생성하세요.
NAVER_EMAIL=your_naver_id@naver.com
NAVER_APP_PASSWORD=your_app_password
