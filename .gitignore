.env
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/
build/
dist/

# Local database and generated data (kept out of git; regenerated by `research-os init`)
data/database/*.db
data/raw/*
data/processed/*
data/knowledge/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/knowledge/.gitkeep

# Logs
logs/*.log*
!logs/.gitkeep

# Reports are personal research output; keep the directory, not generated content
data/reports/*
!data/reports/.gitkeep

secrets/
*.secret
